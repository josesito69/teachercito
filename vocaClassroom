<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Classroom Objects Challenge</title>
<style>
  body {
    font-family: "Poppins", Arial, sans-serif;
    text-align: center;
    background: linear-gradient(135deg, #c8e6c9, #b3e5fc);
    margin: 0;
    padding: 0;
    color: #034159;
  }
  .container {
    max-width: 1000px;
    margin: 40px auto;
    background: #ffffffd8;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0px 4px 20px rgba(0,0,0,0.2);
  }
  h1 {
    font-size: 2.5rem;
    color: #01579b;
    margin-bottom: 10px;
  }
  .subtitle {
    font-size: 1.2rem;
    color: #0277bd;
    margin-bottom: 30px;
  }
  .sentence {
    font-size: 1.8rem;
    font-weight: bold;
    background: #e1f5fe;
    padding: 20px;
    border-radius: 10px;
    margin: 20px 0;
    letter-spacing: 1px;
  }
  .hidden {
    filter: blur(12px);
    user-select: none;
  }
  .teams {
    display: flex;
    justify-content: space-around;
    margin: 30px 0;
    flex-wrap: wrap;
  }
  .team {
    background: #a7ffeb;
    border-radius: 15px;
    padding: 20px;
    width: 200px;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
  }
  .team h2 {
    font-size: 1.5rem;
    color: #004d40;
  }
  .score {
    font-size: 2rem;
    color: #00695c;
  }
  button {
    background: #0288d1;
    color: white;
    border: none;
    padding: 12px 18px;
    margin: 5px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 1.1rem;
    transition: 0.3s;
  }
  button:hover {
    background: #01579b;
  }
  .turn {
    font-size: 1.2rem;
    margin-bottom: 10px;
    color: #004d40;
  }
  @media (max-width: 600px) {
    .sentence {
      font-size: 1.3rem;
      padding: 15px;
    }
    .team {
      width: 100%;
      margin-bottom: 15px;
    }
  }
</style>
</head>
<body>
<div class="container">
  <h1>🎯 Classroom Objects Challenge</h1>
  <p class="subtitle">Two teams compete! Guess the sentence correctly to earn points.</p>
  
  <div class="turn" id="turnDisplay">It's <b>Team A's</b> turn</div>
  <div class="sentence hidden" id="sentenceDisplay">Click “Show Sentence” to start</div>

  <div class="buttons">
    <button onclick="showSentence()">Show Sentence</button>
    <button onclick="nextSentence()">Next Sentence</button>
    <button onclick="addPoint('A')">+1 Point Team A</button>
    <button onclick="addPoint('B')">+1 Point Team B</button>
    <button onclick="restartGame()">Restart Game</button>
  </div>

  <div class="teams">
    <div class="team">
      <h2>Team A 🧩</h2>
      <div class="score" id="scoreA">0</div>
    </div>
    <div class="team">
      <h2>Team B 🚀</h2>
      <div class="score" id="scoreB">0</div>
    </div>
  </div>
</div>

<script>
const sentences = [
  "There is a clock on the wall.",
  "The teacher writes on the board.",
  "I have a ruler in my pencil case.",
  "The scissors are on the desk.",
  "There are books on the shelf.",
  "The lights are on the ceiling.",
  "I use a sharpener for my pencil.",
  "There is a waste basket near the door.",
  "The air conditioner is on the wall.",
  "My backpack is under the desk.",
  "The computer is next to the keyboard.",
  "I use a calculator in math class.",
  "There is a marker on the teacher's desk.",
  "The glue is in the pencil case.",
  "I use a pen to write my notes.",
  "The rubber is next to the notebook.",
  "There is a calendar on the wall.",
  "I use paper clips to hold my papers.",
  "The cutter is on the table.",
  "There is a smart speaker in the classroom."
];

let currentSentence = "";
let currentTeam = "A";
let scoreA = 0;
let scoreB = 0;

function showSentence() {
  const sentenceDisplay = document.getElementById("sentenceDisplay");
  sentenceDisplay.classList.remove("hidden");
}

function nextSentence() {
  const sentenceDisplay = document.getElementById("sentenceDisplay");
  const randomIndex = Math.floor(Math.random() * sentences.length);
  currentSentence = sentences[randomIndex];
  sentenceDisplay.textContent = currentSentence;
  sentenceDisplay.classList.add("hidden");
  switchTurn();
}

function addPoint(team) {
  if (team === "A") {
    scoreA++;
    document.getElementById("scoreA").textContent = scoreA;
  } else {
    scoreB++;
    document.getElementById("scoreB").textContent = scoreB;
  }
  nextSentence();
}

function switchTurn() {
  currentTeam = currentTeam === "A" ? "B" : "A";
  document.getElementById("turnDisplay").innerHTML = `It's <b>Team ${currentTeam}'s</b> turn`;
}

function restartGame() {
  scoreA = 0;
  scoreB = 0;
  currentTeam = "A";
  document.getElementById("scoreA").textContent = 0;
  document.getElementById("scoreB").textContent = 0;
  document.getElementById("turnDisplay").innerHTML = `It's <b>Team A's</b> turn`;
  document.getElementById("sentenceDisplay").textContent = "Click “Show Sentence” to start";
  document.getElementById("sentenceDisplay").classList.add("hidden");
}

nextSentence(); // Start with a random sentence
</script>
</body>
</html>
